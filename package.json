{
  "name": "aliza-wears-api",
  "version": "1.0.0",
  "description": "Aliza Wears E-commerce Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --runInBand",
